# ============================================
# SENSITIVE FILES - NEVER COMMIT THESE!
# ============================================

# Environment files with secrets
.env
.env.*
!.env.example

# Site configuration (contains db passwords, secret keys)
sites/*/site_config.json
sites/common_site_config.json

# Backup files (large + may contain sensitive data)
backup/
*.sql
*.sql.gz
*-database.sql.gz
*-files.tar
*-private-files.tar
*-site_config_backup.json

# Private keys and certificates
*.pem
*.key
*.crt
*.pfx
secrets/

# ============================================
# GENERATED / RUNTIME FILES
# ============================================

# Frappe sites data
sites
sites/*/private/
sites/*/public/files/
sites/*/logs/
sites/*/error-snapshots/
sites/assets/

# Frappe apps (pulled via bench get-app)
# Uncomment if you don't want to track apps in git
# apps/

# Node modules
node_modules/
*/node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.so
.Python
*.egg-info/
.eggs/
*.egg
.venv/
venv/
ENV/

# Logs
logs/
*.log
frappe.log
worker.log

# ============================================
# DOCKER SPECIFIC
# ============================================

# Docker volumes data (if stored locally)
volumes/
data/

# Docker override for local development
# Uncomment if each developer has their own overrides
# docker-compose.override.yml

# ============================================
# OS / IDE SPECIFIC
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# IDE
.idea/
.vscode/
.vscode/**
!.vscode/extensions.json
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.project
.pydevproject
.settings/

# VS Code devcontainer
.devcontainer
*.code-workspace

# ============================================
# MISC
# ============================================

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.cache

# Test coverage
.coverage
htmlcov/
.tox/
.pytest_cache/

# Build artifacts
dist/
build/

development/*
!development/README.md
!development/installer.py
!development/apps-example.json
!development/vscode-example/
