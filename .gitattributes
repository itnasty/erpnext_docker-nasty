# Set default behavior to automatically normalize line endings
* text=auto

# Force shell scripts to always use LF line endings (Unix)
*.sh text eol=lf

# Other files that should use LF
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.env text eol=lf
