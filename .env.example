# ============================================
# FRAPPE DOCKER ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in values
# DO NOT commit .env to git!
# ============================================

# Frappe/ERPNext Version
FRAPPE_VERSION=v15
ERPNEXT_VERSION=v15

# GitHub Token (required for private repos like NSTY)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site Configuration
SITE_NAME=frontend
ADMIN_PASSWORD=changeme_use_strong_password

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=changeme_use_strong_password

# Redis Configuration
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
REDIS_SOCKETIO=redis-socketio:6379

# ============================================
# S3 ATTACHMENT SETTINGS (frappe_s3_attachment)
# ============================================
# Fill these if using S3 for file storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=ap-southeast-1

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Email Configuration (if needed)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_LOGIN=
# MAIL_PASSWORD=
# MAIL_USE_TLS=1

# Sentry Error Tracking (if needed)
# SENTRY_DSN=

# Developer Mode (set to 1 for development)
# DEVELOPER_MODE=0
